(version 1)
; macOS sandbox profile for AGENT shell commands (see scripts/sandbox/agent-shell).
; The last matching rule wins. Params: ROOT = the only project dir agents may write,
; HOME = the user's home.
(allow default)

; writes: the project, temp dirs and tool caches only
(deny file-write*)
(allow file-write*
  (subpath (param "ROOT"))
  (subpath "/private/tmp") (subpath "/private/var/folders")
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/tty") (literal "/dev/dtracehelper")
  (literal "/dev/stdout") (literal "/dev/stderr") (regex #"^/dev/fd/")
  (subpath (string-append (param "HOME") "/.npm"))
  (subpath (string-append (param "HOME") "/.cache"))
  (subpath (string-append (param "HOME") "/Library/Caches")))

; never writable, anywhere: harness state (the human's plan approval), and anything under a .git path
; component (a .git dir or gitfile, its config, hooks, commondir, or .git itself renamed away): git config runs
; code later OUTSIDE the sandbox (core.fsmonitor, hooks) when the harness or the human runs git. The human commits.
(deny file-write* (regex #"/\.harness(/|$)") (regex #"/\.git(/|$)"))
; except a throwaway repo in the temp dirs (a git tool's tests need `git init` there; T15 live: without it the git
; course's checker tests could only skip). Nobody runs git there outside the sandbox, and the match is on the real
; path, so a temp symlink or gitfile pointing at a project's .git still lands on the deny above (gate x59-x62).
(allow file-write* (regex #"^/private/(tmp|var/folders)/.*/\.git(/|$)"))

; project docs (spec 7.2 rule 10): each has one owning agent, which writes it with the write/edit tools (they run
; inside opencode, not in this shell; the agents' edit permissions decide who). No agent shell may create, change,
; move, link or delete one at the project root, mini-projects/<slug>/<name> (`> PLAN.md`, cp, mv, ln, find -exec,
; rg --pre ...), in any letter case (macOS names are case-insensitive; this Mac's sandbox also matches paths without
; case, seen 2026-10-29, and the per-letter classes keep that true where it does not). Deeper files with these names
; (a build's dist/review.md, a package's node_modules/x/DESIGN.md) are plain files. The sandbox matches the resolved
; path, so a symlink to the root file is refused too, and so is a hard link (its source is the root file).
; NOTES.md, LEARNINGS.md and RESEARCH/ stay writable. QA.md (qa) and VISUAL.md (designer) are doc files too.
; (gate cases x41-x58)
(deny file-write*
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Bb][Rr][Ii][Ee][Ff]\.[Mm][Dd]$")
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Bb][Rr][Aa][Ii][Nn][Ss][Tt][Oo][Rr][Mm]\.[Mm][Dd]$")
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Aa][Rr][Cc][Hh][Ii][Tt][Ee][Cc][Tt][Uu][Rr][Ee]\.[Mm][Dd]$")
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Dd][Ee][Ss][Ii][Gg][Nn]\.[Mm][Dd]$")
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Pp][Ll][Aa][Nn]\.[Mm][Dd]$")
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Rr][Ee][Vv][Ii][Ee][Ww]\.[Mm][Dd]$")
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Cc][Rr][Ii][Tt][Ii][Qq][Uu][Ee]\.[Mm][Dd]$")
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Bb][Uu][Gg][Hh][Uu][Nn][Tt]\.[Mm][Dd]$")
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Qq][Aa]\.[Mm][Dd]$")
  (regex #"/[Mm][Ii][Nn][Ii]-[Pp][Rr][Oo][Jj][Ee][Cc][Tt][Ss]/[^/]+/[Vv][Ii][Ss][Uu][Aa][Ll]\.[Mm][Dd]$"))

; secrets: .env files (not .env.example), keys, credential stores, opencode's own auth + sessions
(deny file-read*
  (regex #"/\.env$") (regex #"/\.env\.[^/]+$") (regex #"\.pem$")
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.gnupg"))
  (subpath (string-append (param "HOME") "/.config/gh"))
  (subpath (string-append (param "HOME") "/.local/share/opencode"))
  (literal (string-append (param "HOME") "/.netrc")))
(allow file-read* (regex #"/\.env\.example$"))

; push/publish credentials (R17): the policies against git push / publish are only a speed bump, the sandbox is
; the control. Registry and forge tokens are unreadable, the macOS keychain git helper cannot run (blocked by
; name only: a renamed copy in the project still runs), and the launchd ssh-agent socket cannot be reached
; (agent-shell also unsets SSH_AUTH_SOCK).
(deny file-read*
  (literal (string-append (param "HOME") "/.npmrc"))
  (literal (string-append (param "HOME") "/.pypirc"))
  (literal (string-append (param "HOME") "/.yarnrc.yml"))
  (literal (string-append (param "HOME") "/.git-credentials"))
  (literal (string-append (param "HOME") "/.config/git/credentials")))
(deny process-exec (regex #"/git-credential-osxkeychain$"))
(deny network-outbound (remote unix-socket (path-regex #"^/private/tmp/com\.apple\.launchd\.[^/]+/Listeners$")))
