{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "model": "opencode/big-pickle",
  "small_model": "opencode/glm-5.3-flash-free",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "instructions": ["AGENTS.md", "brain/rules/000-core.md"],
  "permission": {
    "*": "allow",
    "shell": {
      "*": "ask",
      "rm -rf /": "deny",
      "rm -fr /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf /Users*": "deny",
      "rm -rf /System*": "deny",
      "rm -rf /private*": "deny",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "rm -Rf *": "ask",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git clean -*": "deny",
      "git checkout .": "deny",
      "npm publish*": "ask",
      "yarn publish*": "ask",
      "bun publish*": "ask",
      "git push*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "test *": "allow",
      "[ *": "allow",
      "which *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "diff *": "allow",
      "env": "allow",
      "date": "allow",
      "node *": "allow",
      "npm test*": "allow",
      "npm run*": "allow",
      "pnpm test*": "allow",
      "pnpm run*": "allow",
      "python3 *": "allow",
      "bash ~/.config/opencode/scripts/*": "allow",
      "bash scripts/*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/*.pem": "deny",
      "**/id_rsa*": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.git/**": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/.config/opencode/brain/**": "allow",
      "~/.config/opencode/scripts/**": "allow",
      "~/.config/opencode/skills/**": "allow",
      "~/.config/opencode/agents/**": "allow",
      "~/.config/opencode/commands/**": "allow",
      "~/.config/opencode/AGENTS.md": "allow"
    },
    "webfetch": "ask",
    "websearch": "allow",
    "doom_loop": "ask"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 20000
    }
  },
  "tools": {
    "playwright_*": false
  }
}
